# Copy this file to .env and replace with your Neon pooled connection URL.
# Keep this on the backend. Never use a VITE_ prefix for database credentials.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct connection for schema initialization and migrations only.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Local Ollama embeddings (no external AI API key needed).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_CHAT_MODEL=llama3.2:latest

# Optional Vercel provider (currently commented out in the Python callers).
# Never add VITE_ to these names.
AI_GATEWAY_API_KEY=
AI_GATEWAY_EMBEDDING_MODEL=openai/text-embedding-3-small
AI_GATEWAY_CHAT_MODEL=meta/llama-3.3-70b
